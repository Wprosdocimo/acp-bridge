# ai-jail sandbox configuration for acp-bridge
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

# Default (non --private-home) mode auto-discovers every dotdir under $HOME
# and mounts it individually: read-write if it's a known tool-state dir
# (verified live via `ai-jail --dry-run`: .config, .cache, .claude, .kiro,
# .cargo, .local/share/{mise,kiro-cli,opencode,uv,pipx,ai-memory,...} etc.
# all come back `--bind` already), read-only otherwise, and .aws/.ssh/.gnupg
# are never mounted at all (built-in DOTDIR_DENY, confirmed absent from the
# dry-run output). This claim is STALE as of ai-jail 1.20.1 (2026-08-25):
# confirmed live that only the *direct* child command (uv) is actually
# bind-mounted now — ~/.cursor, ~/.config/cursor, ~/.local/bin/*, and every
# mise-managed harness install dir all came back missing from the sandbox
# even though --dry-run's PATH still lists them, causing FileNotFoundError /
# "Authentication required" on every non-uv subprocess spawn (a real stuck
# `cursor` job is what surfaced this).
#
# A second, independent bug compounds this: any TILDE-prefixed path in THIS
# file's rw_maps/ro_maps silently fails to mount once merged through
# ai-jail's trusted-project-config path (`os.path.exists()` false inside the
# sandbox for a `~/...` entry, while the byte-identical path written as
# `/home/wprosdocimo/...` mounts correctly) — confirmed live 2026-08-25 by
# testing both forms back to back.
#
# A THIRD bug (also 2026-08-25): even with absolute paths, ~/.cursor,
# ~/.config/cursor, and ~/.local/share/cursor-agent all resolve correctly in
# `ai-jail status` output but produce *no bwrap mount at all* — `--dry-run`
# omits them entirely, no warning. Looks like a precedence bug where ai-jail's
# own dotdir auto-discovery for a path it also happens to recognize silently
# overrides an explicit project-level map instead of merging with it (the
# unrelated /mnt/wsl/.../Projects entry below, not under any recognized
# dotdir, mounts fine). The identical paths as CLI --map/--rw-map flags DO
# mount correctly, so those three are wired on the systemd unit's ExecStart
# instead (see acp-bridge.service comments) — not duplicated here to avoid
# two sources of truth silently drifting.
#
# Same class of gap likely affects kiro/opencode/claude-agent-acp too and
# will need the same explicit-map treatment (probably also via ExecStart,
# not this file) when one of those is next exercised and found broken.

rw_maps = [
    # Job callers pass an arbitrary `cwd` (e.g. mcp-server/server.py's
    # acp_call/acp_submit_job tools) so a spawned harness can operate on any
    # of the user's actual repos, not just this bridge's own directory.
    # Confirmed live 2026-08-10: a real job with cwd set to a path under
    # /mnt/wsl/PhysicalDrive3p1/Projects/Playground still ran fully isolated
    # — ai-jail only mounts the *bridge's own* project dir by default, so
    # os.makedirs(cwd) inside jobs.py silently created a private, empty
    # sandbox-local directory at that path instead of seeing the real repo.
    # Mounting the whole Projects tree (not just Playground) so any repo
    # under it is reachable, matching the bridge's actual use case: routing
    # work to arbitrary harnesses across all of the user's projects.
    "/mnt/wsl/PhysicalDrive3p1/Projects",
]

# No secrets tracked in acp-bridge's own repo tree (checked 2026-08-10: no
# .env, the only credential-bearing file is config.yaml itself — gitignored,
# holds this bridge's own auth_token — which must stay readable, it's the
# bridge's own config, not a secret to hide from itself).
#
# The Projects mount above is a different story: it now exposes every repo
# under it, including Playground, which has its own real secrets (root
# .env, .devcontainer/.env, tasks/138786/secrets_em_config.md,
# tasks/145186/env-backup/*.env — see Playground's own .ai-jail, written
# 2026-08-05). That file's deny_paths don't apply here — this is a separate
# sandbox config for a separate process — so the same repo-agnostic globs
# are repeated below to cover secrets in Playground or any other repo under
# Projects a harness might be pointed at via `cwd`.
deny_paths = [
    "**/.env",
    "**/.env.*",
    "**/*.env",
    "**/secrets_*",
    "**/*secret*",
    "**/*credentials*",
]

# The globs above are broad enough to match legitimate library source files
# by coincidence once they apply across every repo's dependency tree, not
# just Playground: e.g. redis/credentials.py, botocore/data/secretsmanager,
# pydantic_settings/.../secrets.py. Confirmed live 2026-08-10 — masking
# redis/credentials.py inside acp-bridge's own .venv broke the bridge's own
# startup import (PermissionError on `from redis.credentials import ...`).
# Exempt installed-dependency directories; the goal is hiding project-authored
# secrets, not library code that happens to share a name.
deny_path_exceptions = [
    "**/.venv/**",
    "**/node_modules/**",
    "**/site-packages/**",
    "**/.git/**",
]

no_docker = true
no_gpu = true
no_display = true

# The bridge itself needs network: it binds 127.0.0.1:18010 for inbound
# requests and calls out to LLM provider APIs. ai-jail's network default is
# off unconditionally (README: "capabilities default off: network, GPU,
# display..."); confirmed live 2026-08-25 that --exec mode unshares the net
# namespace same as any other mode, so without this the bridge starts and
# logs "Uvicorn running on http://127.0.0.1:18010" but is unreachable even
# from the host loopback. Requires this project to be listed in the global
# ~/.ai-jail's trust_project_config, since granting a capability from a
# project-level .ai-jail is otherwise ignored (v1.19.0+).
network = true
