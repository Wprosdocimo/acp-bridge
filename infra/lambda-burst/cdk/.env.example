# CDK Deployment Configuration
# Copy to .env and fill in your values.
# NEVER commit .env with real values.

# ─── Required: VPC ───
# Lambda must be in the same VPC as your LiteLLM/Bridge EC2
VPC_ID=vpc-xxxxxxxxxxxxxxxxx

# Private subnet IDs (comma-separated). Lambda needs ENI in these subnets.
# Use private subnets — Lambda does NOT need public internet (it talks to LiteLLM inside VPC).
SUBNET_IDS=subnet-aaaaaaaaaaaaa,subnet-bbbbbbbbbbbbb

# ─── Optional: Security Group ───
# If empty, CDK creates one with restricted egress (LiteLLM port + HTTPS only).
# If you have an existing SG that allows egress to your LiteLLM, specify it here.
SECURITY_GROUP_ID=

# ─── Required: LiteLLM ───
# Internal VPC address of LiteLLM. Lambda accesses this via private network.
# Example: http://10.0.1.79:4000 (your EC2 private IP)
LITELLM_URL=http://10.0.1.79:4000

# ─── Optional: Existing Secrets Manager secret ARN ───
# If you already have the LiteLLM API key in Secrets Manager, specify its ARN.
# If empty, CDK creates a new secret (you must populate it after deploy).
LITELLM_SECRET_ARN=

# ─── Optional: Defaults ───
DEFAULT_MODEL=bedrock/anthropic.claude-sonnet-4-6
MAX_CONCURRENCY=100
